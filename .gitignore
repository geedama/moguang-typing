# 该仓库只发布“魔光打字通”源码；同一工作区中的其他项目和本机运行环境默认忽略。
/*

!/.github/
!/.gitattributes
!/.gitignore
!/README.md
!/VERSION
!/LICENSE

!/docs/
/docs/*
!/docs/keybound-combat-priority.md
!/docs/RELEASING.md
!/docs/LICENSE-OPTIONS.md

!/src/
/src/*
!/src/KeyboundProbe/
/src/KeyboundProbe/artifacts/

!/packaging/
/packaging/*
!/packaging/KeyboundProbe/

!/scripts/
/scripts/*
!/scripts/build-keybound-probe.ps1
!/scripts/deploy-keybound-probe.ps1
!/scripts/package-keybound-probe.ps1
!/scripts/test-keybound-package.ps1
!/scripts/export-keybound-words.ps1
!/scripts/analyze-keybound-combat.ps1

!/tools/
/tools/*
!/tools/keybound-data-probe/
/tools/keybound-data-probe/bin/
/tools/keybound-data-probe/obj/

# 本机状态、构建结果与发布产物
/.env*
/release/
/artifacts/
/.dotnet-cli/
/.tmp*/
**/bin/
**/obj/
**/*.user
**/*.suo
**/*.pdb
**/*.log
**/runtime.js
**/Captures/
**/BridgeRuntime/
